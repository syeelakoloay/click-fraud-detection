# Local Vite development: leave VITE_API_URL empty to use the /api proxy.
# Vite will proxy /api/* and /health to this Express server:
VITE_API_PROXY_TARGET=http://localhost:5000

# For production deployments without a same-origin reverse proxy, set the public API root here.
# Examples:
# VITE_API_URL=https://api.example.com
# VITE_API_URL=https://example.com/api
VITE_API_URL=
