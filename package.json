{
  "name": "click-fraud-detection-backend",
  "version": "1.1.0",
  "private": true,
  "description": "Sistem Deteksi Fraud Klik Iklan Digital: fondasi MongoDB Aktivitas 6, service Aktivitas 8, dan Express Event API Aktivitas 10.",
  "scripts": {
    "init:db": "node src/initDatabase.js",
    "verify:db": "node src/verifyDatabase.js",
    "check:activity8": "node scripts/checkActivity8Syntax.js",
    "test:activity8:unit": "node scripts/testActivity8Utils.js",
    "test:activity8": "node scripts/testActivity8Services.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check:activity10": "node scripts/checkActivity10Syntax.js",
    "test:api:activity10": "node --test scripts/testApiActivity10.js",
    "test:api:activity10:mongo": "node --test scripts/testMongoIntegrationActivity10.js"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "mongoose": "^8.0.0",
    "cors": "^2.8.6",
    "express": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
