{
  "name": "clickguard-aktivitas28-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace terpadu frontend React dan backend Express untuk Aktivitas 28.",
  "scripts": {
    "install:frontend": "npm --prefix frontend ci",
    "install:backend": "npm --prefix backend ci",
    "install:all": "npm run install:backend && npm run install:frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend run test:activity16 && npm --prefix frontend run test:activity28 && npm --prefix frontend run test:currency",
    "check:backend": "npm --prefix backend run check:activity28 && npm --prefix backend run check:syntax",
    "test:backend": "npm --prefix backend test",
    "verify:activity28": "npm run check:backend && npm run test:frontend && npm run build:frontend",
    "audit:dataset": "python backend/ml/audit_dataset.py",
    "test:google-ads": "npm --prefix backend run test:google-ads",
    "train:verified-click": "npm --prefix backend run train:verified-click",
    "train:fdma-publisher": "npm --prefix backend run train:fdma-publisher",
    "train:google-ads": "npm --prefix backend run train:google-ads",
    "train:martech": "npm --prefix backend run train:martech",
    "train:web-robot": "npm --prefix backend run train:web-robot",
    "train:twitter-bot": "npm --prefix backend run train:twitter-bot",
    "test:martech": "npm --prefix backend run test:martech",
    "test:prediction-api": "npm --prefix backend run test:prediction-api",
    "test:web-robot-api": "npm --prefix backend run test:web-robot-api",
    "test:realtime": "npm --prefix backend run test:realtime",
    "test:ingestion-auth": "npm --prefix backend run test:ingestion-auth",
    "test:currency": "npm --prefix frontend run test:currency"
  }
}
