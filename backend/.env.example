MONGODB_URI=mongodb://127.0.0.1:27017/click_fraud_activity15_manual
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/click_fraud_activity15_test

# Python Machine Learning API
ML_API_URL=http://127.0.0.1:8000
ML_API_TIMEOUT_MS=10000

# Real-time test-history route (Aktivitas 17/23/25/27)
# Gunakan endpoint /predict pada layanan Python; kosong berarti hasil ML berstatus unavailable.
PREDICTION_URL=http://127.0.0.1:8000/predict
HISTORY_WINDOW_MINUTES=10
# Optional locally. Required in production for every event/dataset write endpoint.
# Keep this key only in the server-side collector and backend/.env.
EVENT_INGESTION_API_KEY=

# Google Ads API v26 (OAuth2 user flow). Do not commit backend/.env.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Sejak 9 September 2026, Google Ads API tidak lagi memerlukan Developer Token.
# Akses ditentukan oleh project Google Cloud/OAuth dan tingkat akses API.
GOOGLE_ADS_CUSTOMER_ID=3425120099
GOOGLE_ADS_CAMPAIGN_ID=3426120099
GOOGLE_ADS_CAMPAIGN_NAME=advertising
# Optional manager account ID (10 digits, no hyphens) when using a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v26
# Mutations and automated IP exclusion are SAFE-OFF until read-only verification succeeds.
# Google Ads API uses OAuth 2.0; project access level and account permissions are verified by API calls.
GOOGLE_ADS_MUTATIONS_ENABLED=false
GOOGLE_ADS_AUTO_EXCLUDE_ENABLED=false

# Conservative real-time behavioral burst rules. These are policy thresholds,
# not claims that an IP alone proves fraud.
REALTIME_IP_BURST_WINDOW_SECONDS=5
REALTIME_IP_BURST_LIMIT_IDENTIFIED=10
REALTIME_IP_BURST_LIMIT_ANONYMOUS=20
REALTIME_ML_AUTOBLOCK_ENABLED=false
REALTIME_ML_AUTOBLOCK_THRESHOLD=0.99
# Generate a private random key; enter it only for explicit admin actions in the UI.
GOOGLE_ADS_ACTION_KEY=
