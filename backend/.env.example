MONGODB_URI=mongodb://127.0.0.1:27017/click_fraud_activity15_manual
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/click_fraud_activity15_test

# Python Machine Learning API
ML_API_URL=http://127.0.0.1:8000
ML_API_TIMEOUT_MS=10000

# Real-time test-history route (Aktivitas 17/23/25/27)
# Gunakan endpoint /predict pada layanan Python; kosong berarti hasil ML berstatus unavailable.
PREDICTION_URL=http://127.0.0.1:8000/predict
HISTORY_WINDOW_MINUTES=10

# Google Ads API v26 (OAuth2 user flow). Do not commit backend/.env.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional manager account ID (10 digits, no hyphens) when using a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v26
# Read-only connection is available when OAuth is configured. Mutations are SAFE-OFF by default.
GOOGLE_ADS_MUTATIONS_ENABLED=false
# Generate a private random key; enter it only for explicit admin actions in the UI.
GOOGLE_ADS_ACTION_KEY=
